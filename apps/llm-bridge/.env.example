# The subscription bridge on your PC (decision 469). Copy to apps/llm-bridge/.env
# (git-ignored) and fill in. Never commit the real file, never paste the token anywhere else.

# From `claude setup-token`. Valid for a year. Personal, single-user use only.
CLAUDE_CODE_OAUTH_TOKEN=""

# The same value as LLM_BRIDGE_SECRET on Vercel. Generate with: openssl rand -base64 32
LLM_BRIDGE_SECRET=""

# Port the bridge listens on, on 127.0.0.1 only. Tailscale Funnel forwards to it.
LLM_BRIDGE_PORT="8787"

# How many Claude calls run at once; the rest queue. Each one is a Claude Code process.
LLM_BRIDGE_CONCURRENCY="3"

# Do NOT set ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN here: the bridge refuses to start with
# either, because Claude Code would bill the API instead of your plan.
