# Boom-Busters environment (build spec section 4)
#
# Env holds INFRASTRUCTURE and BOOTSTRAP SECRETS ONLY. Behavioural
# configuration (model routing, budgets, TTS voice, brand kit) lives in the
# `settings` table and is edited in the UI — never here.
#
# Copy to `.env.local` and fill in. Never commit a filled-in copy.

# ---------------------------------------------------------------------------
# Required at boot. The app refuses to start and lists every missing key.
# ---------------------------------------------------------------------------

# Postgres (Neon or Supabase). Include ?sslmode=require for hosted providers.
# Drop any &channel_binding=require Neon appends — postgres.js does not support it.
DATABASE_URL="postgresql://user:password@host/boom_busters?sslmode=require"

# Optional: the direct, non-pooled endpoint. Neon's Vercel integration sets
# both, and migrations prefer this one — DDL belongs on a direct connection
# rather than through a transaction-mode pooler. Leave empty if you only have
# one connection string.
DATABASE_URL_UNPOOLED=""

# Auth.js. Generate a secret with: npx auth secret  (or `openssl rand -base64 32`)
AUTH_SECRET="replace-with-32-plus-random-bytes-base64"
AUTH_URL="http://localhost:3000"

# Google OAuth client for signing in to the console itself.
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="000000000000-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-replace-me"

# The single allowlisted account. Every other Google identity is rejected.
OWNER_EMAIL="you@example.com"

# AES-256-GCM key for `provider_credentials` and the YouTube refresh token.
# Exactly 32 bytes, base64-encoded: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"

# ---------------------------------------------------------------------------
# Required at first use. Absent until the milestone that needs them; the app
# boots without these and throws a typed ConfigError naming the missing key
# only when the feature is actually invoked.
# ---------------------------------------------------------------------------

# Cloudflare R2 — input assets: narration takes, stills, stock, music (M4+)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="boom-busters"

# Render broker + media-utils Lambda in the Reelscript AWS account (M6)
AWS_BROKER_URL=""
AWS_BROKER_TOKEN=""

# Inngest durable orchestration (M2). Needed only to run against Inngest Cloud:
# local development and CI use the Inngest Dev Server, which needs neither.
#   npx inngest-cli@latest dev   (then open http://localhost:8288)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Force Dev Server mode even in a production build. Normally unnecessary: the
# SDK talks to Inngest Cloud only when NODE_ENV=production.
INNGEST_DEV=""

# YouTube Data + Analytics OAuth client (M7). Separate from AUTH_GOOGLE_*:
# this one carries the youtube.upload / youtube / yt-analytics.readonly scopes.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Optional. Provider keys are entered in Settings -> Connections and stored
# AES-GCM-encrypted in the database. These env vars are SEEDS ONLY: imported
# into the DB on first boot when no row exists, so local dev works without
# touching the UI. Rotating a key in the UI never needs a redeploy.
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_API_KEY=""
ELEVENLABS_API_KEY=""
PEXELS_API_KEY=""
PIXABAY_API_KEY=""
FAL_API_KEY=""

# ---------------------------------------------------------------------------
# Notifications (M2). Both optional and independent: with neither configured
# the app logs what it would have sent and carries on.
# ---------------------------------------------------------------------------

# Web push (VAPID). Free, no account — generate a pair with:
#   pnpm --filter @boom-busters/web exec web-push generate-vapid-keys
# The public key is served to the browser; the private key never leaves here.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Email copy of a notification, via Resend. Both are required together; the
# from-address must be on a domain verified in Resend.
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL="Boom-Busters <alerts@yourdomain.com>"

# ---------------------------------------------------------------------------
# Optional operational extras
# ---------------------------------------------------------------------------

SENTRY_DSN=""

# Mock-provider mode (build spec section 13). Set to "1" for Playwright and
# local development without paid API calls. It also enables a credentials
# sign-in as OWNER_EMAIL so E2E can run without real Google OAuth.
# Hard-guarded: ignored entirely when NODE_ENV=production.
MOCK_PROVIDERS="0"
